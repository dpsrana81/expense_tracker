FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-chars
JWT_SECRET_KEY=change-this-to-a-random-jwt-secret-key-at-least-32-chars

# Leave unset to use local SQLite. For MySQL / AWS RDS use:
# DATABASE_URL=mysql+pymysql://expense_user:password@localhost:3306/expense_tracker
DATABASE_URL=

JWT_COOKIE_SECURE=False
CORS_ORIGINS=*

USE_S3=False
AWS_S3_BUCKET=
AWS_REGION=us-east-1

PORT=5000
